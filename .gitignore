# ==============================================================================
# Terraform Ignore Rules
# ==============================================================================
# Local .terraform directories (plugins, providers, modules cache)
**/.terraform/
.terraform/

# Terraform state files (local state should never be committed)
*.tfstate
*.tfstate.*
*.tfstate.backup
**/.terraform.tfstate.lock.info

# Terraform execution plan files
*.tfplan
*.plan

# Sensitive variable files
*.tfvars.json
*.auto.tfvars
*.auto.tfvars.json
# Ignore private secrets tfvars, keep example templates
# terraform.tfvars is allowed if containing non-secret project configs
# *.tfvars

# Crash logs
crash.log
crash.*.log
*.log

# Override files (local developer overrides)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc

# ==============================================================================
# OS Metadata & Cache
# ==============================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ==============================================================================
# Editor & IDE Directories
# ==============================================================================
.idea/
.vscode/
*.swp
*.swo
*~
